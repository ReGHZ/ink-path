enum RuleCategory {
  structural
  semantic
}

enum ValidationScope {
  entity
  project
}

enum ValidationTriggerSource {
  reactive
  incremental
  full_scan
  manual
}

enum ValidationRequestStatus {
  pending
  processing
  completed
  failed
}

enum FindingSource {
  rule_engine
  ai
}

enum FindingOutcome {
  conflict
  valid
  unsupported
}

enum IssueSeverity {
  error
  warning
  info
}

enum IssueStatus {
  open
  resolved
  dismissed
  stale
}

enum IssueStaleReason {
  rule_changed
  rule_archived
}

enum IssueTargetRole {
  primary
  secondary
}

enum TemplateScope {
  platform
  user
  community
}

model Rule {
  id                 String       @id @default(uuid()) @db.Uuid
  projectId          String       @map("project_id") @db.Uuid
  name               String
  description        String?
  category           RuleCategory
  ast                Json
  dependencyMetadata Json         @map("dependency_metadata")
  currentVersion     Int          @default(1) @map("current_version")
  isActive           Boolean      @default(true) @map("is_active")
  archivedAt         DateTime?    @map("archived_at")
  templateId         String?      @map("template_id") @db.Uuid
  templateVersion    Int?         @map("template_version")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  template RuleTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  versions        RuleVersion[]
  dependencyIndex RuleDependencyIndex[]
  findings        Finding[]
  issues          Issue[]

  @@index([projectId, isActive])
  @@index([projectId, category])
  @@index([templateId])
  @@map("rules")
}

model RuleVersion {
  id          String   @id @default(uuid()) @db.Uuid
  ruleId      String   @map("rule_id") @db.Uuid
  version     Int
  astSnapshot Json     @map("ast_snapshot")
  changedAt   DateTime @map("changed_at")
  changedById String   @map("changed_by") @db.Uuid

  rule      Rule @relation(fields: [ruleId], references: [id], onDelete: Restrict)
  changedBy User @relation("RuleVersionChangedBy", fields: [changedById], references: [id], onDelete: Restrict)

  findings Finding[]

  @@unique([ruleId, version])
  @@index([ruleId, version(sort: Desc)])
  @@map("rule_versions")
}

model RuleDependencyIndex {
  id            String            @id @default(uuid()) @db.Uuid
  ruleId        String            @map("rule_id") @db.Uuid
  projectId     String            @map("project_id") @db.Uuid
  entityType    ContentEntityType @map("entity_type")
  // null = entity-level (berlaku ke seluruh entity), non-null = attribute-level (field path).
  // Uniqueness di-enforce via 2 partial unique index di init_constraints (bukan @@id/@@unique),
  // karena attributeName nullable tidak bisa jadi PK, dan partial unique gak bisa di-Prisma-native.
  //   - rule_dependency_index_unique_attr   (rule_id, entity_type, attribute_name) WHERE attribute_name IS NOT NULL
  //   - rule_dependency_index_unique_entity (rule_id, entity_type)                WHERE attribute_name IS NULL
  attributeName String?           @map("attribute_name")

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([projectId, entityType, attributeName])
  @@index([ruleId])
  @@map("rule_dependency_index")
}

model ValidationRequest {
  id              String                  @id @default(uuid()) @db.Uuid
  projectId       String                  @map("project_id") @db.Uuid
  scope           ValidationScope
  entityId        String?                 @map("entity_id") @db.Uuid
  entityType      ContentEntityType?      @map("entity_type")
  snapshotPayload Json                    @map("snapshot_payload")
  triggerSource   ValidationTriggerSource @map("trigger_source")
  status          ValidationRequestStatus @default(pending)
  failureReason   String?                 @map("failure_reason")
  leaseExpiresAt  DateTime?               @map("lease_expires_at")
  pendingAiJobs   Int                     @default(0) @map("pending_ai_jobs")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)

  findings Finding[]

  @@index([projectId, status])
  @@index([projectId, scope, entityId])
  @@map("validation_requests")
}

model Finding {
  id                  String         @id @default(uuid()) @db.Uuid
  projectId           String         @map("project_id") @db.Uuid
  validationRequestId String         @map("validation_request_id") @db.Uuid
  ruleId              String?        @map("rule_id") @db.Uuid
  issueId             String?        @map("issue_id") @db.Uuid
  source              FindingSource
  outcome             FindingOutcome
  severity            IssueSeverity?
  message             String?
  fingerprint         String?
  ruleVersionId       String?        @map("rule_version_id") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at")

  project           Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  validationRequest ValidationRequest @relation(fields: [validationRequestId], references: [id], onDelete: Restrict)
  rule              Rule?             @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  issue             Issue?            @relation(fields: [issueId], references: [id], onDelete: SetNull)
  ruleVersion       RuleVersion?      @relation(fields: [ruleVersionId], references: [id], onDelete: SetNull)

  @@index([projectId, validationRequestId])
  @@index([projectId, issueId])
  @@map("findings")
}

model Issue {
  id                       String            @id @default(uuid()) @db.Uuid
  projectId                String            @map("project_id") @db.Uuid
  ruleId                   String?           @map("rule_id") @db.Uuid
  fingerprint              String
  title                    String
  description              String?
  source                   FindingSource
  category                 RuleCategory
  severity                 IssueSeverity
  status                   IssueStatus       @default(open)
  staleReason              IssueStaleReason? @map("stale_reason")
  firstDetectedAt          DateTime          @map("first_detected_at")
  firstDetectedRuleVersion Int?              @map("first_detected_rule_version")
  lastDetectedAt           DateTime          @map("last_detected_at")
  lastDetectedRuleVersion  Int?              @map("last_detected_rule_version")
  resolvedAt               DateTime?         @map("resolved_at")
  createdAt                DateTime          @default(now()) @map("created_at")
  updatedAt                DateTime          @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  rule    Rule?   @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  targets  IssueTarget[]
  findings Finding[]

  @@unique([projectId, fingerprint])
  @@index([projectId, status])
  @@index([projectId, ruleId])
  @@index([projectId, severity, status])
  @@map("issues")
}

model IssueTarget {
  id         String            @id @default(uuid()) @db.Uuid
  issueId    String            @map("issue_id") @db.Uuid
  projectId  String            @map("project_id") @db.Uuid
  entityType ContentEntityType @map("entity_type")
  entityId   String            @map("entity_id") @db.Uuid
  role       IssueTargetRole

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@unique([issueId, entityId, entityType])
  @@index([issueId])
  @@index([entityType, entityId])
  @@map("issue_targets")
}

model EvaluationNode {
  id                String            @id @default(uuid()) @db.Uuid
  projectId         String            @map("project_id") @db.Uuid
  entityId          String            @map("entity_id") @db.Uuid
  entityType        ContentEntityType @map("entity_type")
  attributes        Json              @default("{}")
  timelinePosition  Int?              @map("timeline_position")
  lastEventSequence BigInt            @default(0) @map("last_event_sequence")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  sourceEdges EvaluationEdge[] @relation("EvaluationEdgeSource")
  targetEdges EvaluationEdge[] @relation("EvaluationEdgeTarget")

  @@unique([projectId, entityId])
  @@index([projectId, entityType])
  @@index([projectId, entityType, timelinePosition])
  @@map("evaluation_nodes")
}

model EvaluationEdge {
  id               String   @id @default(uuid()) @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  sourceNodeId     String   @map("source_node_id") @db.Uuid
  targetNodeId     String   @map("target_node_id") @db.Uuid
  relationshipType String   @map("relationship_type")
  metadata         Json     @default("{}")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Step 4b-4 (stage A). PROVENANCE: the assertion this edge is a fold of.
  //
  // The same column `content_relationships` gained in 4b-2, for the same reason
  // and with the same key shape — but the two folds do NOT behave alike, and the
  // difference is the whole point of adding it here
  // (`03-database-design/15_validation_tables.md` §ADDENDUM 2026-08-19 butir 1):
  //
  //   `retract`   → the row is DELETED. The claim counts as never made, at every
  //                 cut, so there is nothing left to fold.
  //   `terminate` → the row STAYS. The fact held before its anchor, and a fold
  //                 that deleted it would answer "never held" to every question
  //                 about every earlier cut. All tests would still be green.
  //
  // Both operations name an ASSERTION ID (premis §8.3), so both are idempotent
  // under retries — and neither could be matched by fact pattern, because two
  // authors are explicitly allowed to assert the same fact and a pattern cannot
  // tell those two assertions apart.
  //
  // NOT NULL, no backfill, no nullable interim step: the table has never been
  // written by production code (verified via the graph index before this stage —
  // zero references outside comments), so this is greenfield rather than a
  // migration over data. Pre-deploy, zero rows (preseden D-3,
  // `06-migration-planning/01:7`).
  //
  // What this column deliberately does NOT carry: the anchor. Truth-at-a-cut is
  // computed by the executor over reachability, three-valued, and materialising a
  // validity range here would force two values on a question whose answer can be
  // `unknown` (§ADDENDUM butir 2).
  sourceAssertionId String @map("source_assertion_id") @db.Uuid

  sourceNode EvaluationNode @relation("EvaluationEdgeSource", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode EvaluationNode @relation("EvaluationEdgeTarget", fields: [targetNodeId], references: [id], onDelete: Cascade)

  // `onDelete: Restrict`, same as the CRUD fold: an applied assertion cannot be
  // deleted through the application at all (append-only), so this refuses the one
  // route left — hand-run SQL — and refuses it for the right reason. An edge whose
  // origin assertion was deleted could no longer say what fact it is a fold of.
  //
  // Composite `(source_assertion_id, project_id)` rather than the id alone: an
  // edge folded from ANOTHER project's assertion is a tenancy leak the database
  // can refuse outright, rather than one that survives until a service forgets to
  // check.
  sourceAssertion TransitionEffect @relation(fields: [sourceAssertionId, projectId], references: [id, projectId], onDelete: Restrict, onUpdate: Restrict)

  // §ADDENDUM butir 6: the predicate reference takes the shape 4a settled on —
  // `relationship_type text` + composite FK — and NOT a `predicate_id` column
  // (`02-system-design/06_validation_domain.md` writes `predicate_id`; the shape
  // in `15` wins, and both now carry a dated addendum saying so).
  //
  // Why it has to be here and not only on `content_relationships`: two folds over
  // the SAME log must name a predicate the same way, or "which predicate" has two
  // answers. `onUpdate: Restrict` is the stated price — renaming a predicate is
  // refused while facts still reference it, exactly as in 4a.
  definition RelationshipDefinition @relation(fields: [projectId, relationshipType], references: [projectId, predicate], onDelete: Restrict, onUpdate: Restrict)

  // One edge per ASSERTION, and that is the fold's identity — not
  // (project, source, target, predicate). Keyed on the assertion, `assert →
  // terminate → assert again` produces two rows that both keep their own
  // provenance, which is the interval SET premis §8.3 calls coherent; keyed on the
  // fact, the second assert would collide with the row the terminate left behind
  // and the re-assertion would be lost. It is also the index the composite foreign
  // key above needs, and what makes a redelivered event an upsert instead of a
  // duplicate.
  @@unique([sourceAssertionId, projectId])
  @@index([projectId, sourceNodeId])
  @@index([projectId, targetNodeId])
  @@index([projectId, relationshipType])
  @@map("evaluation_edges")
}

model RuleTemplate {
  id                   String        @id @default(uuid()) @db.Uuid
  name                 String
  description          String?
  category             RuleCategory
  patternName          String        @map("pattern_name")
  astTemplate          Json          @map("ast_template")
  parameterDefinitions Json?         @map("parameter_definitions")
  scope                TemplateScope
  currentVersion       Int           @default(1) @map("current_version")
  createdById          String?       @map("created_by") @db.Uuid
  usageCount           Int           @default(0) @map("usage_count")
  isVerified           Boolean       @default(false) @map("is_verified")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  createdBy User? @relation("RuleTemplateCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  tags     RuleTemplateTag[]
  versions TemplateVersion[]
  rules    Rule[]

  @@index([scope, isVerified])
  @@index([scope, usageCount(sort: Desc)])
  @@index([createdById])
  @@map("rule_templates")
}

model RuleTemplateTag {
  templateId String @map("template_id") @db.Uuid
  tag        String

  template RuleTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@id([templateId, tag])
  @@index([tag])
  @@map("rule_template_tags")
}

model TemplateVersion {
  id                   String   @id @default(uuid()) @db.Uuid
  templateId           String   @map("template_id") @db.Uuid
  version              Int
  astTemplate          Json     @map("ast_template")
  parameterDefinitions Json?    @map("parameter_definitions")
  changedAt            DateTime @map("changed_at")
  changedById          String?  @map("changed_by") @db.Uuid

  template  RuleTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)
  changedBy User?        @relation("TemplateVersionChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@unique([templateId, version])
  @@index([templateId, version(sort: Desc)])
  @@map("template_versions")
}
